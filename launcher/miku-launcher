#!/usr/bin/env python3

import os
import subprocess
import threading
import signal
import time
import gi

gi.require_version("Gtk", "3.0")

from gi.repository import Gtk, Gdk, Gio, GLib, GdkPixbuf


MIKU_IMAGE = os.path.expanduser(
    "~/.config/miku-launcher/assets/miku.png"
)

PID_FILE = f"/tmp/miku-launcher-{os.getuid()}.pid"
TOGGLE_GUARD = f"/tmp/miku-launcher-{os.getuid()}.toggle"
TOGGLE_DELAY = 0.45

