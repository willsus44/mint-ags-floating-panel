#!/usr/bin/env bash

# Espera a que AGS esté ejecutándose
for i in $(seq 1 50); do
    if pgrep -f '/usr/local/bin/ags' >/dev/null 2>&1; then
        break
    fi
    sleep 0.1
done

# Espera a que existan exactamente las 4 ventanas permanentes de AGS:
# PanelReserve + IslandLeft + IslandCenter + IslandRight
for i in $(seq 1 100); do
    count=$(
        wmctrl -lx 2>/dev/null \
        | grep -c 'com.github.Aylur.ags'
    )

    if [ "$count" -ge 4 ]; then
        break
    fi

    sleep 0.1
done

# Espera a que las 4 estén correctamente marcadas como:
# DOCK + SKIP_TASKBAR
for i in $(seq 1 100); do
    good=0

    while read -r id; do
        props=$(xprop -id "$id" \
            _NET_WM_WINDOW_TYPE \
            _NET_WM_STATE 2>/dev/null)

        if echo "$props" | grep -q '_NET_WM_WINDOW_TYPE_DOCK' \
        && echo "$props" | grep -q '_NET_WM_STATE_SKIP_TASKBAR'; then
            good=$((good + 1))
        fi
    done < <(
        wmctrl -lx 2>/dev/null \
        | awk '/com\.github\.Aylur\.ags/ {print $1}'
    )

    if [ "$good" -ge 4 ]; then
        break
    fi

    sleep 0.1
done

# Inicia Plank una sola vez, ya con AGS listo
if ! pgrep -x plank >/dev/null 2>&1; then
    nohup plank >/tmp/plank-reloaded.log 2>&1 &
fi
